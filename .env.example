# Arıza Defteri ayarları. Bu dosyayı .env olarak kopyala; .env GitHub'a GÖNDERİLMEZ.
# Ayrıntı: docs/SUNUCU_KURULUMU.md

# --- Adres -------------------------------------------------------------------
APP_URL=https://ariza.ysfdurak.com/
PORT=8080
DATA_DIR=/data

# --- Üretim ------------------------------------------------------------------
# Sentetik veri üretimi. Kurum içinde gerçek veriyle kullanırken false yap.
SENTETIK=true
# İlk açılışta kaç günlük geçmiş üretilsin (sonra her gün kendiliğinden eklenir). Nabız Analiz 3 yıl kullanır: gerçek sıklıkta aşınmayı görmek için 1 yıl yetmez.
GECMIS_GUN=1095

# --- Okuma sınırı --------------------------------------------------------------
# Okuma API'si herkese açıktır (veri sentetik). Ziyaretçi başına dakikada en fazla bu kadar istek.
DAKIKALIK_ISTEK=60

# --- Yazma API'si (Nabız gibi uygulamalar gerçek arıza bildirir) ----------------
# Boş bırakılırsa yazma kapalıdır. Birden çok anahtar virgülle. Üretmek için: openssl rand -hex 32
YAZMA_ANAHTARLARI=

# --- MCP kapısı: Claude ve diğer yapay zekâ istemcileri (docs/MCP.md) ---------
# Varsayılan kapalı. Açmak için en az bir anahtar gerekir (üretmek için: openssl rand -hex 32).
MCP_ENABLED=false
MCP_ANAHTARLARI=
